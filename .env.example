# Copy to .env (or run `make env` / `bash scripts/stack.sh env`, which also generates the secret).
# .env is git-ignored: never commit real secrets.

# Required by the api: at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# Host port of the gateway (bound to 127.0.0.1). Change it if 8080 is already used.
GATEWAY_PORT=8080

# Images pulled by `make up` (published to GHCR by the S1-02 reusable workflows)
API_IMAGE=ghcr.io/horizon-social-network-m2-sre/horizon-backend:main
WEB_IMAGE=ghcr.io/horizon-social-network-m2-sre/horizon-web:main

# `make up-local` builds from these checkouts instead
BACKEND_DIR=../horizon-backend
WEB_DIR=../horizon-web

# Start the web app too once horizon-web has its Dockerfile (S1-10): COMPOSE_PROFILES=web
COMPOSE_PROFILES=
